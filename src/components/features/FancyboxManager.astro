---
// Fancybox 管理器组件
---

<script>
  let Fancybox: any;
  const EXCALIDRAW_PREVIEW_SELECTOR = '.custom-md img[src*="/excalidraw-preview/"]';
  const EXCALIDRAW_SELECTOR = ".custom-md img[data-excalidraw-scene], " + EXCALIDRAW_PREVIEW_SELECTOR;
  const IMG_SELECTOR = ".custom-md img:not(.card-wiki-link img):not([data-excalidraw-scene]):not([src*='/excalidraw-preview/']), #post-cover img, .moment-images img";
  const LINK_SELECTOR = ".moment-images a[data-fancybox], [data-fancybox]:not(.moment-images a)";
  const svgBlobUrlCache = new Map<string, string>();
  const DEBUG_FANCYBOX = import.meta.env.DEV;

  function describeElement(el: Element) {
    return {
      tagName: el.tagName,
      srcAttribute: el.getAttribute("src"),
      currentSrc: el instanceof HTMLImageElement ? el.currentSrc : undefined,
      href: el.getAttribute("href"),
      dataExcalidrawScene: el.getAttribute("data-excalidraw-scene"),
      matchesImageSelector: el.matches(IMG_SELECTOR),
      matchesExcalidrawSelector: el.matches(EXCALIDRAW_SELECTOR),
    };
  }

  function logFancyboxDiagnostic(message: string, detail?: unknown) {
    if (!DEBUG_FANCYBOX) return;
    console.info(`[Fancybox diagnostic] ${message}`, detail);
  }

  function isSvgSrc(src: string): boolean {
    if (!src) return false;
    try {
      const url = new URL(src, location.href);
      if (url.pathname.toLowerCase().endsWith(".svg")) return true;
      if (url.searchParams.get("f")?.toLowerCase() === "svg") return true;
    } catch { return false; }
    return false;
  }

  function revokeAllSvgBlobUrls() {
    for (const url of svgBlobUrlCache.values()) URL.revokeObjectURL(url);
    svgBlobUrlCache.clear();
  }

  /**
   * 灯箱 CSS 按需注入：用 ?url 拿静态资源地址，Astro 不会把 ?url 导入的样式打进页面头部。
   * 仅在页面存在可点开图片时才真正加载；Swup 换页被 updateHead 顶掉后，下次 setup() 会重新注入
   * （网络层有 hash 缓存，不产生额外请求）。
   */
  let cssUrls: string[] = [];
  async function injectFancyboxCss(): Promise<void> {
    if (cssUrls.length === 0) {
      const [fancyboxCss, customCss] = await Promise.all([
        import("@fancyapps/ui/dist/fancybox/fancybox.css?url"),
        import("@/styles/fancybox-custom.css?url"),
      ]);
      cssUrls = [fancyboxCss.default, customCss.default].filter(
        (u): u is string => typeof u === "string",
      );
    }
    for (const url of cssUrls) {
      if (!document.head.querySelector(`link[href="${url}"]`)) {
        const link = document.createElement("link");
        link.rel = "stylesheet";
        link.href = url;
        document.head.appendChild(link);
      }
    }
  }

  async function getSvgBlobUrl(
    src: string,
    fallbackW: number,
    fallbackH: number,
    sourceElement: Element,
  ): Promise<string | null> {
    const cached = svgBlobUrlCache.get(src);
    if (cached) {
      logFancyboxDiagnostic("Reusing SVG Blob URL", {
        source: src,
        element: describeElement(sourceElement),
      });
      return cached;
    }
    try {
      const resp = await fetch(src);
      if (!resp.ok) { console.debug("[Fancybox] SVG fetch failed:", resp.status, src); return null; }
      const svgText = await resp.text();
      const parser = new DOMParser();
      const doc = parser.parseFromString(svgText, "image/svg+xml");
      if (doc.querySelector("parsererror")) { console.debug("[Fancybox] SVG parse error:", src); return null; }
      const svgEl = doc.querySelector("svg");
      if (!svgEl) { console.debug("[Fancybox] No <svg> element:", src); return null; }
      if (!svgEl.getAttribute("width") || !svgEl.getAttribute("height")) {
        const vb = svgEl.getAttribute("viewBox");
        let w = String(fallbackW), h = String(fallbackH);
        if (vb) {
          const parts = vb.split(/[\s,]+/);
          if (parts.length >= 4 && Number(parts[2]) > 0 && Number(parts[3]) > 0) {
            w = parts[2]; h = parts[3];
          }
        }
        if (!svgEl.getAttribute("width")) svgEl.setAttribute("width", w);
        if (!svgEl.getAttribute("height")) svgEl.setAttribute("height", h);
      }
      const blob = new Blob([new XMLSerializer().serializeToString(svgEl)], { type: "image/svg+xml" });
      const blobUrl = URL.createObjectURL(blob);
      svgBlobUrlCache.set(src, blobUrl);
      if (DEBUG_FANCYBOX) {
        console.warn("[Fancybox diagnostic] Created SVG Blob URL", {
          source: src,
          blobUrl,
          element: describeElement(sourceElement),
          stack: new Error().stack,
        });
      }
      return blobUrl;
    } catch (err) { console.debug("[Fancybox] SVG preprocess error:", src, err); return null; }
  }

  function getCommonOptions() {
    return {
      Thumbs: {
        autoStart: true,
        showOnStart: "yes",
      },
      Toolbar: {
        display: {
          left: ["counter"],
          middle: [
            "zoomIn",
            "zoomOut",
            "toggle1to1",
            "rotateCCW",
            "rotateCW",
            "flipX",
            "flipY",
          ],
          right: ["slideshow", "thumbs", "close"],
        },
      },
      animated: true,
      dragToClose: true,
      keyboard: {
        Escape: "close",
        Delete: "close",
        Backspace: "close",
        PageUp: "next",
        PageDown: "prev",
        ArrowUp: "next",
        ArrowDown: "prev",
        ArrowRight: "next",
        ArrowLeft: "prev",
      },
      fitToView: true,
      preload: 3,
      infinite: true,
      Panzoom: {
        maxScale: 3,
        minScale: 1,
      },
      caption: false,
    };
  }

  function getExcalidrawOptions() {
    const editButton = {
      tpl: '<button class="f-button excalidraw-edit-button" type="button" title="在 Excalidraw 中编辑" aria-label="在 Excalidraw 中编辑"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M14 3h7v7h-2V6.41l-9.29 9.3-1.42-1.42L17.59 5H14V3ZM5 5h6v2H7v10h10v-4h2v6H5V5Z"/></svg></button>',
      click: (carousel: any) => {
        const activeSlide = carousel.getPage()?.slides?.[0];
        const rawScenePath = activeSlide?.triggerEl?.getAttribute("data-excalidraw-scene");
        if (!rawScenePath) {
          logFancyboxDiagnostic("Excalidraw edit button could not find a scene URL", activeSlide);
          return;
        }

        const sceneUrl = new URL(rawScenePath, window.location.origin).href;
        const editorUrl = `https://excalidraw.com/#url=${encodeURIComponent(sceneUrl)}`;
        logFancyboxDiagnostic("Opening Excalidraw editor", { sceneUrl, editorUrl });
        window.open(editorUrl, "_blank", "noopener,noreferrer");
      },
    };

    return {
      ...getCommonOptions(),
      groupAll: false,
      // Excalidraw 预览是单张图片。禁用 Hash 插件，避免打开灯箱时写入
      // #excalidraw 并触发站点的路由生命周期。
      Hash: false,
      Carousel: {
        transition: "slide",
        preload: 2,
        Toolbar: {
          items: { excalidrawEdit: editButton },
          display: {
            left: ["counter"],
            middle: [
              "zoomIn",
              "zoomOut",
              "toggle1to1",
              "rotateCCW",
              "rotateCW",
              "flipX",
              "flipY",
            ],
            right: ["excalidrawEdit", "slideshow", "thumbs", "close"],
          },
        },
      },
    };
  }

  async function preprocessSvgImages() {
    const promises: Promise<void>[] = [];

    if (DEBUG_FANCYBOX) {
      const excalidrawPreviews = Array.from(
        document.querySelectorAll<HTMLImageElement>(EXCALIDRAW_PREVIEW_SELECTOR),
      ).map(describeElement);
      logFancyboxDiagnostic("Excalidraw preview selector state before SVG preprocessing", excalidrawPreviews);
    }

    document.querySelectorAll<HTMLImageElement>(IMG_SELECTOR).forEach((img) => {
      if (img.dataset.svgFixed) return;
      const src = img.getAttribute("src") || "";
      if (!isSvgSrc(src)) return;
      logFancyboxDiagnostic("SVG image selected for Blob preprocessing", describeElement(img));
      const fallbackW = img.naturalWidth || img.clientWidth || 1600;
      const fallbackH = img.naturalHeight || img.clientHeight || 900;
      promises.push(
        getSvgBlobUrl(src, fallbackW, fallbackH, img).then((blobUrl) => {
          if (blobUrl) {
            img.dataset.originalSrc = src;
            img.src = blobUrl;
            img.dataset.svgFixed = "true";
          }
        })
      );
    });

    document.querySelectorAll<HTMLElement>(LINK_SELECTOR).forEach((el) => {
      if (el.dataset.svgFixed) return;
      const attr = el.hasAttribute("data-src") ? "data-src" : "href";
      const svgSrc = el.getAttribute(attr) || "";
      if (!isSvgSrc(svgSrc)) return;
      logFancyboxDiagnostic("SVG link selected for Blob preprocessing", describeElement(el));
      promises.push(
        getSvgBlobUrl(svgSrc, 1600, 900, el).then((blobUrl) => {
          if (blobUrl) {
            el.dataset.originalSrc = svgSrc;
            el.setAttribute(attr, blobUrl);
            el.dataset.svgFixed = "true";
          }
        })
      );
    });

    await Promise.allSettled(promises);
  }

  async function setup() {
    if (!document.querySelector(IMG_SELECTOR) && !document.querySelector(LINK_SELECTOR) && !document.querySelector(EXCALIDRAW_SELECTOR)) return;

    await injectFancyboxCss();

    if (!Fancybox) {
      const mod = await import("@fancyapps/ui");
      Fancybox = mod.Fancybox;
    }

    const commonOptions = getCommonOptions();

    await preprocessSvgImages();

    // Dynamic galleries expose their images through the toolbar button. Remove
    // previous bindings before re-binding after client-rendered content appears.
    Fancybox.unbind(IMG_SELECTOR);
    Fancybox.unbind(LINK_SELECTOR);
    Fancybox.unbind(EXCALIDRAW_SELECTOR);

    Fancybox.bind(IMG_SELECTOR, {
      ...commonOptions,
      groupAll: true,
      Carousel: {
        transition: "slide",
        preload: 2,
      },
    });

    Fancybox.bind(`${LINK_SELECTOR}:not(dynamic-gallery [data-gallery-lightbox])`, {
      ...commonOptions,
      source: (el: any) => el.getAttribute("data-src") || el.getAttribute("href"),
    });

    Fancybox.bind(EXCALIDRAW_SELECTOR, {
      ...getExcalidrawOptions(),
    });

  }

  function cleanupFancybox() {
    if (Fancybox) {
      Fancybox.close();
      Fancybox.unbind(document.body);
    }
    // 恢复原始 URL 并清除标记，避免 blob URL 被 revoke 后图片损坏
    document.querySelectorAll<HTMLElement>("[data-svg-fixed]").forEach((el) => {
      const original = el.dataset.originalSrc;
      if (!original) return;
      if (el instanceof HTMLImageElement) el.src = original;
      else if (el.hasAttribute("data-src")) el.setAttribute("data-src", original);
      else if (el.hasAttribute("href")) el.setAttribute("href", original);
      delete el.dataset.svgFixed;
      delete el.dataset.originalSrc;
    });
    revokeAllSvgBlobUrls();
  }

  // 初始化
  setup();

  // Swup 生命周期整合
  // 切页换入后延到下一帧再 setup：让首帧先绘制，避免每趟对全图 querySelectorAll +
  // fetch(blob) 的同步长任务阻塞换入瞬间（尤其文章页图多时）。setup 内部有
  // data-svg-fixed / Fancybox.unbind 守卫，延一帧不会重绑或丢图。
  document.addEventListener("swup:content:replace", () => {
    requestAnimationFrame(setup);
  });
  document.addEventListener("dynamic-gallery:ready", () => {
    requestAnimationFrame(setup);
  });
  document.addEventListener("swup:visit:start", cleanupFancybox);

  // 加密文章解密后重新绑定灯箱
  document.addEventListener("password:decrypted", () => {
    setTimeout(setup, 200);
  });
</script>
